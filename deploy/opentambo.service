# Example systemd unit for a *custom* per-user layout (models on a mounted
# disk, runtime in a nonstandard path). For the standard system-wide layout
# do not install this file: `sudo opentambo install` generates a hardened
# unit at /etc/systemd/system/opentambo.service automatically, and
# `sudo opentambo uninstall` removes it. See docs/deployment.md.
#
# Adapt user, group, paths and the mount point before using this example.

[Unit]
Description=OpenTambo - llama.cpp process manager and persistent KV-cache proxy
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/models

[Service]
Type=simple
User=tamboadmin
Group=tamboadmin
WorkingDirectory=/var/lib/opentambo-custom
ExecStartPre=/usr/bin/mountpoint -q /srv/models
ExecStart=/usr/local/bin/opentambo --models /srv/models/gguf --llama-server /opt/llama.cpp/bin/llama-server --data /var/lib/opentambo-custom --listen 127.0.0.1:8090
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0027

[Install]
WantedBy=multi-user.target
